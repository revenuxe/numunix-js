# Set these in the deployment host's Production environment, not just in this local file.
# Admin sign-in obtains only public-safe settings from /api/public/config at runtime.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional build-time browser configuration; never put secret/service-role keys here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy anon JWT naming is also accepted: SUPABASE_ANON_KEY / NEXT_PUBLIC_SUPABASE_ANON_KEY.
# Existing VITE_SUPABASE_URL and VITE_SUPABASE_PUBLISHABLE_KEY deployments remain compatible
# during migration; the app does not depend on Vite. Do not put secret/service-role keys here.

# Server-only optional integrations.
RESEND_API_KEY=
KEEPALIVE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local database management only.
SUPABASE_DB_URL=
ADMIN_EMAIL=
