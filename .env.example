# Server-side configuration (also supports browser admin sign-in via a public-only action).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional build-time browser configuration; never put secret/service-role keys here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only optional integrations.
RESEND_API_KEY=
KEEPALIVE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local database management only.
SUPABASE_DB_URL=
ADMIN_EMAIL=
