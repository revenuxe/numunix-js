# Project Settings > API: project URL and publishable key (legacy anon key also supported).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: local migration connection. Leave empty to use your logged-in Supabase CLI account.
# For direct credentials: Dashboard > Connect > Session pooler (port 5432).
# Paste the full PostgreSQL URI with your database password URL-encoded.
# Never prefix this with VITE_ or put a secret/service-role key in a VITE_ variable.
SUPABASE_DB_URL=

# Email of an existing Supabase Authentication user to grant admin access.
ADMIN_EMAIL=

# Server-only Resend key; also set in Vercel Production environment variables and redeploy.
# onboarding@resend.dev can only send to the Resend account email: numunix@gmail.com.
# Never prefix this secret with VITE_.
RESEND_API_KEY=
